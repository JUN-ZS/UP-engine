{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ige-agent-run-manifest/0.1",
  "title": "IGE SHQ Agent Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "method_id", "source", "read_receipt", "geometry_contract", "permission", "tile_plan", "backend", "output_path"],
  "properties": {
    "schema": {"const": "ige-agent-run-manifest/0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}},
    "read_receipt": {"type": "object", "required": ["source_sha256", "candidate_only", "observations"], "properties": {"source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "candidate_only": {"const": true}, "observations": {"type": "object", "required": ["topology_error"], "properties": {"topology_error": {"type": "object", "required": ["state", "verification"], "properties": {"state": {"enum": ["absent", "resolved", "present", "unknown"]}, "verification": {"type": "string"}}}}}}},
    "geometry_contract": {"type": "object", "required": ["source_sha256", "canvas_path", "canvas_sha256", "coordinate_frame", "geometry_human_verified", "object_transform", "model_scale", "tile_size", "tile_context"], "properties": {"source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "canvas_path": {"type": "string", "minLength": 1}, "canvas_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "coordinate_frame": {"type": "string", "minLength": 1}, "geometry_human_verified": {"const": true}, "object_transform": {"type": "object", "minProperties": 1}, "model_scale": {"type": "number", "exclusiveMinimum": 0}, "tile_size": {"type": "integer", "minimum": 32}, "tile_context": {"type": "integer", "minimum": 0}}},
    "permission": {"type": "object", "required": ["human_reviewed", "permission_granted", "base_sha256", "coordinate_canvas_sha256", "approved_edit_mask_path", "approved_edit_mask_sha256", "protected_mask_path", "protected_mask_sha256", "target_regions", "reviewer_ref", "reviewed_at"], "properties": {"human_reviewed": {"const": true}, "permission_granted": {"const": true}, "base_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "coordinate_canvas_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "approved_edit_mask_path": {"type": "string", "minLength": 1}, "approved_edit_mask_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "protected_mask_path": {"type": "string", "minLength": 1}, "protected_mask_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "target_regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reviewer_ref": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}},
    "tile_plan": {"type": "object", "required": ["verified", "tile_size", "tile_context"], "properties": {"verified": {"const": true}, "tile_size": {"type": "integer", "minimum": 32}, "tile_context": {"type": "integer", "minimum": 0}}},
    "backend": {"type": "object", "required": ["checkpoint_path", "checkpoint_sha256", "license_review_acknowledged"], "properties": {"checkpoint_path": {"type": "string", "minLength": 1}, "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "license_review_acknowledged": {"const": true}, "device": {"enum": ["auto", "cpu", "cuda"]}}},
    "output_path": {"type": "string", "minLength": 1}
  }
}
