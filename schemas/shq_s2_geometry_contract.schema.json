{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ige-shq-s2-geometry-contract/1.0",
  "title": "SHQ S2 human-verified geometry contract (Comfy bridge input)",
  "type": "object",
  "required": ["source_sha256", "canvas_path", "canvas_sha256", "coordinate_frame", "geometry_human_verified", "object_transform", "model_scale", "tile_size", "tile_context"],
  "properties": {
    "source_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "canvas_path": {"type": "string", "minLength": 1},
    "canvas_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "coordinate_frame": {"type": "string", "minLength": 1},
    "geometry_human_verified": {"const": true},
    "object_transform": {"type": "object", "minProperties": 1},
    "model_scale": {"type": "number", "exclusiveMinimum": 0},
    "tile_size": {"type": "integer", "minimum": 32},
    "tile_context": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true,
  "$comment": "Field names and semantics match geometry_contract in schemas/agent_run_manifest.schema.json. The bridge additionally checks source/canvas SHA bindings, canvas dimensions = source dimensions × model_scale, and tile_context < tile_size."
}
