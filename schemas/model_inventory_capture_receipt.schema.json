{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JUN-ZS/UP-engine/schemas/model_inventory_capture_receipt.schema.json",
  "title": "UP-engine model inventory disk-capture receipt",
  "description": "Provenance receipt produced by ige capture-model-inventory after reading weight files from disk and recomputing size+SHA-256. Distinct from hand-authored declared inventory JSON. Never grants execution or edit permission; never runs inference.",
  "type": "object",
  "required": [
    "schema",
    "receipt_kind",
    "evidence_grade",
    "capture_tool",
    "capture_tool_version",
    "package_version",
    "policy",
    "host",
    "models_root",
    "captured_at",
    "algorithm",
    "assets",
    "non_claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ige-model-inventory-capture-receipt/0.1"},
    "receipt_kind": {"const": "model_inventory_capture"},
    "evidence_grade": {"const": "disk_capture"},
    "capture_tool": {"const": "ige.capture-model-inventory"},
    "capture_tool_version": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "policy": {"const": "fail_closed"},
    "method_id_context": {"type": "string"},
    "host": {
      "type": "object",
      "required": ["hostname"],
      "additionalProperties": false,
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "os": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "models_root": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute models root that was read during capture."
    },
    "captured_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp when capture finished."
    },
    "algorithm": {"const": "sha256"},
    "chunk_size_bytes": {"type": "integer", "minimum": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "role",
          "relative_path",
          "filename",
          "size_bytes",
          "sha256",
          "hashed_at"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["unet", "vae", "clip", "upscale", "other"]},
          "relative_path": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "hashed_at": {"type": "string", "minLength": 1},
          "absolute_path": {"type": "string"}
        }
      }
    },
    "custom_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_id", "present"],
        "additionalProperties": false,
        "properties": {
          "pack_id": {"type": "string", "minLength": 1},
          "present": {"type": "boolean"},
          "git_sha": {"type": ["string", "null"]},
          "remote_hint": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "load_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unet_weight_dtype": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"}
  }
}
