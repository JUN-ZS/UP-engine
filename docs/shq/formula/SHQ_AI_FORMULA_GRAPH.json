        "v": "q @ A_scene + b_scene + c"
      },
      "S_star": "S = 1/a",
      "py": "ddxx_pose_formula.py",
      "locks": [
        "E-36 no solver drift",
        "E-37 semantic landmarks",
        "E-38 no cross-model ACCEPT"
      ]
    },
    "MULTI_RETURN": {
      "flow": "N x SOLO(peep,anchors,donor,gates) -> EMPTY x S* -> HARDPASTE + slot_ratio",
